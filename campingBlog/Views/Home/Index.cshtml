@{
    ViewData["Title"] = "Home Page";
}

<div class="hero p-5 text-center bg-image rounded-3" >
    <div class="mask" style="background-color: rgba(0, 0, 0, 0.6);">
        <div class="d-flex justify-content-center align-items-center h-500">
            <div class="" style="padding: 10px; color:#FFDAC2;">
                <h1 class="mb-3">CampingBlog</h1>
                <h4 class="mb-3">A blog site about camping</h4>
                <br/>
                <a class="btn btn-outline-light btn-lg" style="color: #FFDAC2;" asp-area="" asp-controller="Posts" asp-action="Index">View Posts</a>
            </div>
        </div>
    </div>
</div>


<!-- add description of the website -->
<div class="block">
    <div class="row">
    <div class="span4">
        <img class="img-right" src="~/imgs/forest.jpg"/>
        <div class="content-heading">
            <h3>What It Is &nbsp </h3>
            </div>
            <p>
                CampingBlog is a bloging website about camping. It is a place where you can find information about camping, share your camping experiences, and find new places to camp.
            </p>
            <p>
                This site manages posts that are created by users. Users can create posts, edit posts, and delete posts. Users can also comment on posts.
                Posts are sorted into catagories such as reviews, tips, news, stories and more.
            </p>
    </div>
    </div>
</div>

